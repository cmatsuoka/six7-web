{
  "name": "six7",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Six7 — a browser FM synthesizer with a display cluster in the style of a 1980s FM synth, powered by libslopsix",
  "license": "MIT",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm:debug": "SIX7_ASSERTIONS=1 bash scripts/build-wasm.sh",
    "dev": "vite",
    "dev:secure": "vite --host --mode secure",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sysex": "node scripts/test-sysex.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@types/webmidi": "^2.1.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  }
}
